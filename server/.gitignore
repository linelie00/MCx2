# dependencies
/node_modules

# uploaded media (로컬 저장소 — 레포에 포함하지 않음)
/uploads

# 라이브 갤러리 데이터 (gallery.seed.json 이 기본값, 실데이터는 추적 안 함)
/src/data/gallery.json

# 라이브 방명록 데이터 (실데이터는 추적 안 함)
/src/data/guestbook.json

# 라이브 플레이리스트 데이터 (playlists.seed.json 이 기본값, 실데이터는 추적 안 함)
/src/data/playlists.json

# 라이브 영화 데이터 (movies.seed.json 이 기본값, 실데이터는 추적 안 함)
/src/data/movies.json

# 라이브 카지노 계정 데이터 (accounts.seed.json 이 기본값, 실데이터는 추적 안 함)
# .tmp 는 쓰다가 죽었을 때 남는 조각이다 — 커밋될 일이 없다.
/src/data/accounts.json
/src/data/accounts.json.tmp

# env
.env
.env.local
