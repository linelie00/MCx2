# 오너 쓰기 권한 패스코드 (실제 값은 .env 에 넣으세요 — .env 는 git에 안 올라감)
# 두 오너에게만 쓰기(업로드/삭제/태그편집/플레이리스트 수정) 권한이 있습니다.
OWNER_MATIAM_KEY=
OWNER_MIGEL_KEY=

# 디스코드 봇 전용 키 (/api/accounts — 칩·칭호·아이템).
# 오너 패스코드와 **다른 값**을 쓴다. 오너 패스코드는 사이트에서 사람이 직접 넣는 값이라,
# 그걸로 칩을 만질 수 있으면 브라우저에서 남의 잔액을 고칠 수 있게 된다.
# 비워 두면 /api/accounts 는 전부 401 이다(열리지 않는다).
BOT_KEY=

# YouTube Data API v3 키 (플레이리스트 곡 추가 시 메타 조회용)
# https://console.cloud.google.com 에서 YouTube Data API v3 사용 설정 후 발급
YOUTUBE_API_KEY=

# 허용할 프론트 도메인 (쉼표 구분). 비우면 전체 허용(로컬 개발).
# 프로덕션 예시: CORS_ORIGIN=https://mihearti.netlify.app
CORS_ORIGIN=

# 리버스 프록시(Railway 등) 뒤에 둘 때 1 로 설정 (방명록 IP 쿨다운 정확도).
# TRUST_PROXY=1

# 업로드 파일당 최대 용량(MB). 기본 500. 큰 파일 일시 허용 시 키운다(예: 2000).
# MAX_UPLOAD_MB=500

# 영구 데이터 저장 경로 (관리형 볼륨). 설정 시 이 아래에 *.json 라이브 데이터와 uploads/ 저장.
# 미설정 시 로컬 경로(server/src/data, server/uploads) 사용. Railway 예시: DATA_DIR=/data
# DATA_DIR=

# 서버 포트 (선택, 기본 8000 — Railway는 PORT를 자동 주입)
# PORT=8000
