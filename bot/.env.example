# 실제 값은 .env 에 넣으세요 — .env 는 git에 안 올라갑니다.
# Railway 에서는 봇 서비스의 Variables 에 같은 이름으로 넣습니다.

# ===== Discord =====
# Developer Portal > Bot > Reset Token
DISCORD_TOKEN=
# Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=
# 명령을 등록할 서버 ID. 길드 스코프로만 등록해 즉시 반영되게 한다(전역은 최대 1시간 지연).
DISCORD_GUILD_ID=

# 두 사람의 디스코드 유저 ID (개발자 모드 > 프로필 우클릭 > 사용자 ID 복사)
# 쓰기 명령 권한을 이 매핑으로만 판단한다.
DISCORD_USER_MIGEL=
DISCORD_USER_MATIAM=

# ===== MIHEARTI API =====
# Railway 서버 서비스의 공개 도메인. 끝에 슬래시를 붙이지 않는다.
# 예: https://mihearti-api.up.railway.app
MIHEARTI_API_BASE=http://localhost:8000

# server 의 .env 와 같은 값을 넣는다.
OWNER_MIGEL_KEY=
OWNER_MATIAM_KEY=

# ===== Gemini (캐입 핑퐁) =====
# Google AI Studio 에서 발급 (무료 티어)
GEMINI_API_KEY=
# 비워두면 기본값을 쓴다. 구글이 모델 id 를 자주 갈아치우므로,
# 404 가 나면 봇이 쓸 수 있는 모델 목록을 보여준다. 그때 골라 넣으면 된다.
GEMINI_MODEL=
# 무료 티어 보호용 자체 가드. 실제 한도는 AI Studio 대시보드에서 확인할 것.
GEMINI_RPM=8
GEMINI_RPD=300

# ===== 음성 재생 (8단계에서 사용) =====
# standalone 바이너리를 받아 python3 설치를 피한다.
YOUTUBE_DL_FILENAME=yt-dlp_linux
# YouTube 가 막을 때 코드 배포 없이 조정하는 손잡이.
# 예: --extractor-args youtube:player_client=android_vr
YTDLP_EXTRA_ARGS=
# 선택. base64(cookies.txt). 반드시 버리는 계정으로만 만들 것.
YT_COOKIES_B64=
# 아무도 없거나 재생이 멈춘 뒤 자동 퇴장까지의 초.
VOICE_IDLE_SEC=300
